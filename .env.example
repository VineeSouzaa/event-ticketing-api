# Local dev only — matches docker-compose.yml. Copy to .env and adjust if needed.

# Postgres (core/database) — system of record, atomic conditional updates for correctness
DATABASE_URL=postgresql://event_ticketing:event_ticketing@localhost:5435/event_ticketing

# Redis (core/cache) — read-performance cache + Pub/Sub for core/realtime, never source of truth
REDIS_URL=redis://localhost:6379

# MongoDB (core/logging) — structured observability logs only, never catalog/transactional data
MONGO_URL=mongodb://event_ticketing:event_ticketing@localhost:27017/event_ticketing?authSource=admin
